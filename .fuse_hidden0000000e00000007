<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
let an = <?= count($activitiesData) + 3 ?>;

function addActRow(){
  an++;
  const tr = document.createElement('tr');
  tr.innerHTML = `<td class="nc">${an}</td>
    <td><input name="prog_type[]" placeholder="—"></td>
    <td><input name="prog_name[]" placeholder="—" style="text-align:right"></td>
    <td><input name="prog_total[]" placeholder="—"></td>`;
  document.querySelector('#actTable tbody')?.appendChild(tr);
}

function makeBar(id, labels, datasets, h) {
  const el = document.getElementById(id); if(!el) return;
  el.parentElement.style.height = (h||160) + 'px';
  new Chart(el, {
    type: 'bar',
    data: { labels, datasets },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { ticks: { font: { size: 8 }, maxRotation: 45, autoSkip: false }, grid: { display: false } },
        y: { ticks: { font: { size: 8 } }, grid: { color: '#f3f4f6' } }
      }
    }
  });
}

function makeDonut(id, data, colors, h) {
  const el = document.getElementById(id); if(!el) return;
  el.parentElement.style.height = (h||150) + 'px';
  new Chart(el, {
    type: 'doughnut',
    data: { datasets: [{ data, backgroundColor: colors, borderWidth: 3, borderColor: '#fff' }] },
    options: { responsive: true, maintainAspectRatio: false, cutout: '60%', plugins: { legend: { display: false } } }
  });
}

function makeLine(id, labels, data, h) {
  const el = document.getElementById(id); if(!el) return;
  el.parentElement.style.height = (h||130) + 'px';
  new Chart(el, {
    type: 'line',
    data: {
      labels,
      datasets: [{
        data,
        borderColor: '#1d4ed8',
        backgroundColor: 'rgba(29,78,216,0.08)',
        borderWidth: 2,
        pointRadius: 3,
        pointBackgroundColor: '#1d4ed8',
        tension: 0.3,
        fill: true
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { ticks: { font: { size: 8 } }, grid: { display: false } },
        y: { ticks: { font: { size: 8 } }, grid: { color: '#f3f4f6' } }
      }
    }
  });
}

