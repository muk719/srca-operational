<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>التحديث اليومي - الاتصال المؤسسي</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',Tahoma,Arial,sans-serif;background:#f5f5f5;direction:rtl;min-height:100vh}

.page-header{background:#fff;border-bottom:1px solid #e5e7eb;padding:12px 20px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:10}
.org-ar{font-size:13px;font-weight:700;color:#111827}
.org-en{font-size:9px;color:#9ca3af;letter-spacing:.4px}

.page-title-bar{background:#fff;padding:10px 20px 0;display:flex;align-items:center;justify-content:space-between;border-bottom:2px solid #dc2626}
.page-title{font-size:14px;font-weight:700;color:#111827;padding-bottom:10px}
.daily-badge{font-size:11px;color:#6b7280;padding-bottom:10px}

.main-container{max-width:1100px;margin:20px auto;padding:0 16px;display:grid;grid-template-columns:1fr 320px;gap:20px;align-items:start}
@media(max-width:800px){.main-container{grid-template-columns:1fr}}

.bubble-card{background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:20px;position:relative}
.bubble-card-title{font-size:13px;font-weight:700;color:#6b7280;margin-bottom:14px;text-align:left;border-bottom:1px solid #f0f0f0;padding-bottom:8px}

.bubble-canvas{position:relative;height:480px;width:100%}
svg.lines{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:1}

.center-node{position:absolute;left:50%;top:44%;transform:translate(-50%,-50%);z-index:3;display:flex;flex-direction:column;align-items:center;gap:8px}
.center-ring{width:124px;height:124px;border-radius:50%;border:4px solid #dc2626;background:#fff;display:flex;align-items:center;justify-content:center}
.center-text{font-size:14px;font-weight:700;color:#dc2626;text-align:center;line-height:1.4}
.center-input{width:140px;border:1px solid #e5e7eb;border-radius:8px;padding:6px 8px;font-size:11px;font-family:inherit;outline:none;resize:none;direction:rtl;background:#fff;color:#111827;min-height:40px}
.center-input:focus{border-color:#dc2626}

.bubble{position:absolute;display:flex;flex-direction:column;align-items:center;gap:5px;z-index:2}
.bubble-ring{border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;border:3.5px solid;cursor:default;transition:transform .15s}
.bubble-ring:hover{transform:scale(1.05)}
.bubble-ring i{font-size:28px}
.bubble-label{font-size:11px;font-weight:700;text-align:center;line-height:1.3;max-width:95px}
.bubble-val{border:1.5px solid #e5e7eb;border-radius:7px;width:64px;padding:4px;text-align:center;font-size:20px;font-weight:700;outline:none;background:#fff;color:#111827;font-family:inherit;cursor:text}
.bubble-val:focus{border-color:#dc2626;background:#fef2f2}

.sidebar{display:flex;flex-direction:column;gap:14px}

.stat-block{background:#fff;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden}
.stat-block-head{padding:10px 14px;font-size:12px;font-weight:700;border-bottom:1px solid #f0f0f0;display:flex;align-items:center;gap:6px}
.stat-block-body{padding:10px 14px;display:flex;flex-direction:column;gap:8px}
.stat-row{display:flex;align-items:center;justify-content:space-between;gap:8px}
.stat-row-label{font-size:11px;color:#6b7280;font-weight:600;flex:1}
.stat-row-input{width:64px;border:1px solid #e5e7eb;border-radius:6px;padding:4px 6px;font-size:14px;font-weight:700;text-align:center;outline:none;font-family:inherit;color:#111827;background:#fff}
.stat-row-input:focus{border-color:#dc2626;background:#fef2f2}

.event-block{background:#fff;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden}
.event-block-head{padding:10px 14px;font-size:12px;font-weight:700;color:#dc2626;border-bottom:1px solid #f0f0f0;display:flex;align-items:center;gap:6px}
.event-block-body{padding:10px 14px}
.event-block-body textarea{width:100%;border:1px solid #e5e7eb;border-radius:8px;padding:8px;font-size:12px;font-family:inherit;outline:none;resize:vertical;direction:rtl;color:#111827;background:#fff;min-height:80px}
.event-block-body textarea:focus{border-color:#dc2626}

.send-block{background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:14px}
.btn-send{width:100%;padding:10px;background:#166534;color:#fff;border:none;border-radius:9px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:6px}
.btn-send:hover{background:#14532d}
.btn-send:active{transform:scale(.98)}

.msg{display:none;margin-top:10px;background:#f0fdf4;color:#166534;border:1px solid #86efac;border-radius:8px;padding:9px 12px;font-size:12px;font-weight:700;text-align:center}
.msg.show{display:block}

.footer{display:flex;align-items:center;justify-content:flex-end;gap:5px;padding:10px 20px;border-top:1px solid #e5e7eb;background:#fff;margin-top:20px}
.f-social{width:20px;height:20px;border-radius:50%;font-size:9px;font-weight:700;color:#fff;display:flex;align-items:center;justify-content:center}
.f-997{background:#dc2626;color:#fff;border-radius:5px;padding:2px 8px;font-size:12px;font-weight:700}

.deco{display:flex;height:5px;margin-bottom:0}
.deco span{flex:1}
</style>
</head>
<body>

<div class="page-header">
  <div>
    <div class="org-ar">هيئة الهلال الأحمر السعودي</div>
    <div class="org-en">SAUDI RED CRESCENT AUTHORITY</div>
  </div>
  <svg width="42" height="42" viewBox="0 0 44 44">
    <circle cx="22" cy="22" r="20" fill="#fef2f2" stroke="#fca5a5" stroke-width="1"/>
    <path d="M22 7 a15 15 0 0 1 0 30 a11 11 0 0 0 0-30z" fill="#991b1b"/>
    <polygon points="26,13 27.2,16.8 31,16.8 28,19.2 29.2,23 26,20.8 22.8,23 24,19.2 21,16.8 24.8,16.8" fill="#991b1b"/>
  </svg>
</div>

<div class="deco">
  <span style="background:#dc2626;flex:3"></span>
  <span style="background:#f59e0b;flex:1"></span>
  <span style="background:#dc2626;opacity:.5;flex:.6"></span>
</div>

<div class="page-title-bar">
  <div class="page-title">قسم الاتصال المؤسسي</div>
  <div class="daily-badge">تحديث يومي</div>
</div>

<div class="main-container">

  <div class="bubble-card">
    <div class="bubble-card-title">مخطط التحديث اليومي</div>
    <div class="bubble-canvas" id="canvas">

      <svg class="lines" id="svgLines">
        <line id="l1" stroke="#d1d5db" stroke-width="2" stroke-dasharray="6 4"/>
        <line id="l2" stroke="#d1d5db" stroke-width="2" stroke-dasharray="6 4"/>
        <line id="l3" stroke="#d1d5db" stroke-width="2" stroke-dasharray="6 4"/>
        <line id="l4" stroke="#d1d5db" stroke-width="2" stroke-dasharray="6 4"/>
        <line id="l5" stroke="#d1d5db" stroke-width="2" stroke-dasharray="6 4"/>
        <line id="l6" stroke="#d1d5db" stroke-width="2" stroke-dasharray="6 4"/>
      </svg>

      <div class="center-node" id="nodeCenter">
        <div class="center-ring">
          <div class="center-text">أهم<br>الأحداث:</div>
        </div>
        <textarea class="center-input" id="evMain" placeholder="الحدث الرئيسي..."></textarea>
      </div>
      <div class="bubble" id="b1" style="top:8%;right:16%">
        <div class="bubble-ring" style="width:82px;height:82px;border-color:#b0b7c3;background:#f5f6f8">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 6h3a1 1 0 0 1 1 1v11a2 2 0 0 1-4 0V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h11"/><line x1="8" y1="8" x2="12" y2="8"/><line x1="8" y1="12" x2="12" y2="12"/><line x1="8" y1="16" x2="12" y2="16"/></svg>
        </div>
        <div class="bubble-label" style="color:#6b7280">الأخبار المنشورة:</div>
        <input class="bubble-val" type="number" value="0" min="0" oninput="syncSidebar('v1',this.value)">
      </div>

      <div class="bubble" id="b2" style="top:40%;right:2%">
        <div class="bubble-ring" style="width:90px;height:90px;border-color:#84cc16;background:#f0fce4">
          <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#4d7c0f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
        </div>
        <div class="bubble-label" style="color:#4d7c0f">التغطيات الإعلامية:</div>
        <input class="bubble-val" type="number" value="0" min="0" oninput="syncSidebar('v2',this.value)">
      </div>

      <div class="bubble" id="b3" style="bottom:8%;right:12%">
        <div class="bubble-ring" style="width:84px;height:84px;border-color:#06b6d4;background:#ecfeff">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0e7490" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><circle cx="8.5" cy="7.5" r=".5"/><circle cx="6.5" cy="12.5" r=".5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg>
        </div>
        <div class="bubble-label" style="color:#0e7490">تصاميم التواصل الداخلي:</div>
        <input class="bubble-val" type="number" value="0" min="0" oninput="syncSidebar('v3',this.value)">
      </div>

      <div class="bubble" id="b4" style="bottom:2%;left:50%;transform:translateX(-50%)">
        <div class="bubble-ring" style="width:96px;height:96px;border-color:#dc2626;background:#fef2f2">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#991b1b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l19-9-9 19-2-8-8-2z"/></svg>
        </div>
        <div class="bubble-label" style="color:#991b1b">إعلانات الفرع:</div>
        <input class="bubble-val" type="number" value="0" min="0" oninput="syncSidebar('v4',this.value)">
      </div>

      <div class="bubble" id="b5" style="bottom:8%;left:12%">
        <div class="bubble-ring" style="width:84px;height:84px;border-color:#f59e0b;background:#fffbeb">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#92400e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5.8 11.3L2 22l10.7-3.79"/><path d="M4 3h.01"/><path d="M22 8h.01"/><path d="M15 2h.01"/><path d="M22 20h.01"/><path d="m22 2-2.24.75a2.9 2.9 0 0 0-1.96 3.12v0c.1.86-.57 1.63-1.45 1.63h-.38c-.86 0-1.6.6-1.76 1.44L14 10"/><path d="m22 13-.82-.33c-.86-.34-1.82.2-1.98 1.11v0c-.11.7-.72 1.22-1.43 1.22H17"/><path d="m11 2 .33.82c.34.86-.2 1.82-1.11 1.98v0C9.52 4.9 9 5.52 9 6.23V7"/><path d="M11 13c1.93 1.93 2.83 4.17 2 5-.83.83-3.07-.07-5-2-1.93-1.93-2.83-4.17-2-5 .83-.83 3.07.07 5 2z"/></svg>
        </div>
        <div class="bubble-label" style="color:#92400e">الفعاليات الداخلية:</div>
        <input class="bubble-val" type="number" value="0" min="0" oninput="syncSidebar('v5',this.value)">
      </div>

      <div class="bubble" id="b6" style="top:40%;left:2%">
        <div class="bubble-ring" style="width:82px;height:82px;border-color:#b0b7c3;background:#f5f6f8">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.51"/></svg>
        </div>
        <div class="bubble-label" style="color:#6b7280">حدث متداول:</div>
        <input class="bubble-val" type="number" value="0" min="0" oninput="syncSidebar('v6',this.value)">
      </div>

    </div>
  </div>

  <div class="sidebar">

    <div class="stat-block">
      <div class="stat-block-head" style="color:#dc2626">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>
        ملخص التحديث
      </div>
      <div class="stat-block-body">
        <div class="stat-row">
          <div class="stat-row-label" style="color:#6b7280">الأخبار المنشورة:</div>
          <input class="stat-row-input" id="v1" type="number" value="0" min="0" oninput="syncBubble(0,this.value)">
        </div>
        <div class="stat-row">
          <div class="stat-row-label" style="color:#4d7c0f">التغطيات الإعلامية:</div>
          <input class="stat-row-input" id="v2" type="number" value="0" min="0" oninput="syncBubble(1,this.value)">
        </div>
        <div class="stat-row">
          <div class="stat-row-label" style="color:#0e7490">تصاميم التواصل:</div>
          <input class="stat-row-input" id="v3" type="number" value="0" min="0" oninput="syncBubble(2,this.value)">
        </div>
        <div class="stat-row">
          <div class="stat-row-label" style="color:#991b1b">إعلانات الفرع:</div>
          <input class="stat-row-input" id="v4" type="number" value="0" min="0" oninput="syncBubble(3,this.value)">
        </div>
        <div class="stat-row">
          <div class="stat-row-label" style="color:#92400e">الفعاليات الداخلية:</div>
          <input class="stat-row-input" id="v5" type="number" value="0" min="0" oninput="syncBubble(4,this.value)">
        </div>
        <div class="stat-row">
          <div class="stat-row-label" style="color:#6b7280">حدث متداول:</div>
          <input class="stat-row-input" id="v6" type="number" value="0" min="0" oninput="syncBubble(5,this.value)">
        </div>
      </div>
    </div>

    <div class="event-block">
      <div class="event-block-head">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        أهم الأحداث
      </div>
      <div class="event-block-body">
        <textarea id="evMainSide" placeholder="اكتب أهم أحداث اليوم هنا..." oninput="document.getElementById('evMain').value=this.value"></textarea>
      </div>
    </div>

    <div class="event-block">
      <div class="event-block-head" style="color:#374151">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        ملاحظات إضافية
      </div>
      <div class="event-block-body">
        <textarea placeholder="أي ملاحظات إضافية..."></textarea>
      </div>
    </div>

    <div class="send-block">
      <button class="btn-send" onclick="handleSend()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        إرسال للأدمن
      </button>
      <div class="msg" id="successMsg">✅ تم إرسال التحديث اليومي للأدمن بنجاح</div>
    </div>

  </div>
</div>

<div class="footer">
  <div class="f-social" style="background:#1da1f2">t</div>
  <div class="f-social" style="background:#e1306c">i</div>
  <div class="f-social" style="background:#1877f2">f</div>
  <div class="f-997">997</div>
</div>

<script>
const bubbleIds = ['b1','b2','b3','b4','b5','b6'];
const sideIds   = ['v1','v2','v3','v4','v5','v6'];

function getBubbleInput(bIdx){
  return document.getElementById(bubbleIds[bIdx])?.querySelector('input');
}

function syncSidebar(sideId, val){
  const el = document.getElementById(sideId);
  if(el) el.value = val;
}

function syncBubble(bIdx, val){
  const inp = getBubbleInput(bIdx);
  if(inp) inp.value = val;
}

function center(el){
  const c = document.getElementById('canvas');
  const cr = c.getBoundingClientRect();
  const r  = el.getBoundingClientRect();
  return {x: r.left - cr.left + r.width/2, y: r.top - cr.top + r.height/2};
}

function setLine(id, a, b){
  const l = document.getElementById(id);
  if(!l) return;
  l.setAttribute('x1', a.x); l.setAttribute('y1', a.y);
  l.setAttribute('x2', b.x); l.setAttribute('y2', b.y);
}

function drawLines(){
  const ctr = center(document.getElementById('nodeCenter'));
  bubbleIds.forEach((bid, i) => {
    const el = document.getElementById(bid);
    if(el) setLine('l'+(i+1), ctr, center(el));
  });
}

function handleSend(){
  const msg = document.getElementById('successMsg');
  msg.classList.add('show');
  setTimeout(() => msg.classList.remove('show'), 4000);
}

setTimeout(drawLines, 150);
window.addEventListener('resize', drawLines);
document.getElementById('evMain').addEventListener('input', function(){
  document.getElementById('evMainSide').value = this.value;
});
</script>
</body>
</html>